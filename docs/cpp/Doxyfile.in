# Doxyfile - C++ API Documentation for libspeech

DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "libspeech C++"
PROJECT_NUMBER         = @PROJECT_VERSION@
PROJECT_BRIEF          = "Lightweight speech processing library"
OUTPUT_DIRECTORY       = @OUTPUT_DIR@
OUTPUT_LANGUAGE        = English

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

INPUT                  = @PROJECT_SOURCE_DIR@/docs/cpp/mainpage.md \
                         @PROJECT_SOURCE_DIR@/include/libspeech
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.h
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */detail/*
USE_MDFILE_AS_MAINPAGE = @PROJECT_SOURCE_DIR@/docs/cpp/mainpage.md
INCLUDE_PATH           = @PROJECT_SOURCE_DIR@/include
EXAMPLE_PATH           =
EXAMPLE_PATTERNS       = *.cpp
EXAMPLE_RECURSIVE      = NO

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
ALPHABETICAL_INDEX     = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_STYLESHEET        = @AWESOME_HTML_STYLESHEET@
HTML_EXTRA_STYLESHEET  = @AWESOME_HTML_EXTRA_STYLESHEET@
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_FOOTER            = @OUTPUT_DIR@/footer.html

GENERATE_LATEX         = NO

HAVE_DOT               = @HAVE_DOT@
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
DOT_IMAGE_FORMAT       = svg
DOT_CLEANUP            = YES

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
PREDEFINED             = SPEECH_API= LS_ALWAYS_INLINE=inline
SKIP_FUNCTION_MACROS   = YES
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_LOGFILE           = @OUTPUT_DIR@/doxygen_warnings.log
